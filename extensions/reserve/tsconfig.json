{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2018",
    "jsx": "react",
    "rootDir": "./src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["../../node_modules/@evershop/evershop/dist/components/*"]
    }
  },
  "include": ["src"]
}
