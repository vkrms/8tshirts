# Neon (use the DIRECT host, not the -pooler one)
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=shop
DB_USER=neondb_owner
DB_PASSWORD=change-me
DB_SSLMODE=require

# Cloudflare R2 via EverShop's built-in S3 provider
AWS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_FORCE_PATH_STYLE=false
AWS_REGION=auto
AWS_BUCKET_NAME=tshirt-media
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# Public URL of the bucket root (custom domain or r2.dev). Set BEFORE uploading photos.
AWS_S3_BASE_URL=https://media.example.com
